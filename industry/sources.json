    {
      "id": "gh-claude-code",
      "name": "Claude Code（GitHub Releases）",
      "kind": "rss",
      "config": {
        "feedUrl": "https://github.com/anthropics/claude-code/releases.atom",
        "detail": {
          "maxFetches": 10,
          "publishedAtSelector": "relative-time"
        },
        "_aihot": {
          "initialBackfillLimit": 8
        }
      },
      "tier": "T1",
      "owner_entity_id": "claude-code",
      "participation_mode": "editorial",
      "interval_minutes": 60,
      "tags": [
        "官方",
        "版本"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
